{
  // Dedicated Worker connected to fa.focom-iliad.fr.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "free-assistance",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
